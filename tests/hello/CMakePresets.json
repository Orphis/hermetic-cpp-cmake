{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/../../toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HERMETIC_LLVM_VERSION": "23.1.0"
      }
    },
    {
      "name": "host",
      "inherits": "base",
      "displayName": "Host build with hermetic LLVM"
    },
    {
      "name": "linux-x86_64",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-x86_64"
      }
    },
    {
      "name": "linux-x86_64-musl",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-x86_64",
        "HERMETIC_LLVM_LIBC": "musl"
      }
    },
    {
      "name": "linux-x86_64-gnu.2.34",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-x86_64",
        "HERMETIC_LLVM_LIBC": "gnu.2.34"
      }
    },
    {
      "name": "linux-aarch64",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-aarch64"
      }
    },
    {
      "name": "linux-aarch64-musl",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-aarch64",
        "HERMETIC_LLVM_LIBC": "musl"
      }
    },
    {
      "name": "linux-armv7-musl",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-armv7",
        "HERMETIC_LLVM_LIBC": "musl"
      }
    },
    {
      "name": "linux-riscv64-musl",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-riscv64",
        "HERMETIC_LLVM_LIBC": "musl"
      }
    },
    {
      "name": "host-latest",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_VERSION": "latest"
      }
    },
    {
      "name": "host-21.1.8",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_VERSION": "21.1.8"
      }
    },
    {
      "name": "host-first-22",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_VERSION": "first:>=22"
      }
    },
    {
      "name": "linux-x86_64-gnu.2.44",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-x86_64",
        "HERMETIC_LLVM_LIBC": "gnu.2.44"
      }
    },
    {
      "name": "linux-x86_64-asan",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-x86_64",
        "HERMETIC_LLVM_RUNTIME_SANITIZERS": "ON",
        "HERMETIC_LLVM_EXTRA_COMPILE_FLAGS": "-fsanitize=address;-fno-omit-frame-pointer",
        "HERMETIC_LLVM_EXTRA_LINK_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "linux-x86_64-ubsan",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-x86_64",
        "HERMETIC_LLVM_RUNTIME_SANITIZERS": "ON",
        "HERMETIC_LLVM_EXTRA_COMPILE_FLAGS": "-fsanitize=undefined",
        "HERMETIC_LLVM_EXTRA_LINK_FLAGS": "-fsanitize=undefined"
      }
    },
    {
      "name": "linux-aarch64-asan",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-aarch64",
        "HERMETIC_LLVM_RUNTIME_SANITIZERS": "ON",
        "HERMETIC_LLVM_EXTRA_COMPILE_FLAGS": "-fsanitize=address;-fno-omit-frame-pointer",
        "HERMETIC_LLVM_EXTRA_LINK_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "linux-armv7",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-armv7"
      }
    },
    {
      "name": "linux-riscv64",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-riscv64"
      }
    },
    {
      "name": "linux-s390x",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-s390x"
      }
    },
    {
      "name": "linux-s390x-musl",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "linux-s390x",
        "HERMETIC_LLVM_LIBC": "musl"
      }
    },
    {
      "name": "darwin-x86_64",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "darwin-x86_64"
      }
    },
    {
      "name": "darwin-aarch64",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "darwin-aarch64"
      }
    },
    {
      "name": "windows-x86_64",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "windows-x86_64"
      }
    },
    {
      "name": "windows-aarch64",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "windows-aarch64"
      }
    },
    {
      "name": "windows-x86_64-vs2022",
      "inherits": "base",
      "cacheVariables": {
        "HERMETIC_LLVM_TARGET": "windows-x86_64",
        "HERMETIC_LLVM_MSVC_VERSION": "14.44",
        "HERMETIC_LLVM_WINDOWS_SDK_VERSION": "10.0.22621"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
